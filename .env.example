# CancelChain — приклад оточення. Реальні значення тільки в .env (у .gitignore)
# і в Railway/Vercel Variables. Жодного секрету в репозиторії.

# ── Мережа ─────────────────────────────────────────────────────────────────
# Subscriptions Delegation Program живе і на devnet, і на mainnet.
# Продукт розробляється на devnet; жоден SC-* не потребує mainnet.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE_ME

# Розрахунковий актив — тільки USDC (FR-020). Адреса міну devnet-USDC.
USDC_MINT=REPLACE_ME

# ── База даних ─────────────────────────────────────────────────────────────
# Обов'язково transaction pooler (порт 6543): на free tier лише 2 конекшени,
# а сервісів двоє. З pgbouncer prepared statements не працюють — prepare: false.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── API ────────────────────────────────────────────────────────────────────
PORT=8080
API_URL=http://localhost:8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Знімає вимогу підключатися через pooler (порт 6543). Тільки для локального
# Postgres: на Supabase пряме підключення з'їдає конекшени, потрібні indexer'у.
ALLOW_DIRECT_DATABASE=false
# Підпис короткоживучих токенів мерчанта (15 хв, заголовок Authorization).
# Щонайменше 32 символи — API без цього не стартує.
JWT_SECRET=REPLACE_ME
# Домен, який гаманець показує людині при вході в панель мерчанта, і який їде
# в підписаному повідомленні. Рівно хост (і порт), без https:// і без шляху:
# підпис за інший домен не приймається. Локально — хост і порт, на якому
# відкрита сторінка панелі, а не той, на якому слухає API.
AUTH_DOMAIN=localhost:8080
# Origin-и браузерів, яким дозволено читати /v1 з іншого хоста, через кому.
# Порожньо — лише свій origin. Сторінка на GitHub Pages живе на іншому хості,
# ніж API, тож її origin (https://<owner>.github.io) називається тут явно.
# Рівно origin: без шляху і без слеша в кінці, зірочка не приймається.
CORS_ORIGINS=

# ── Індексатор ─────────────────────────────────────────────────────────────
# false → fallback без WebSocket: полінг getSignaturesForAddress раз на 15 с.
# Вмикати, якщо трафік програми з'їдає ліміт кредитів (PLAN.md → Ризики #3).
INDEXER_USE_WS=true
# Глибина стрічки подій, FR-029. Менше 90 порушує вимогу.
EVENTS_RETENTION_DAYS=90

# ── Сповіщення ─────────────────────────────────────────────────────────────
# Згенерувати: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:REPLACE_ME

# ── Тестовий мерчант (FR-023) ──────────────────────────────────────────────
# ТІЛЬКИ devnet. Шлях до keypair поза репозиторієм. На mainnet не вказувати.
MERCHANT_SIM_KEYPAIR_PATH=./.secrets/merchant-devnet.keypair.json

# ── Фронтенд (Vite, префікс VITE_ робить змінну публічною) ──────────────────
# Не задано — фронтенд стукає у власний origin, а в розробці /v1 проксює Vite
# на http://localhost:8080. Задавати треба лише тоді, коли API живе на іншому хості.
VITE_API_URL=
VITE_SOLANA_CLUSTER=devnet
# mock | api. Не задано — api. Мок показує вигадані числа замість дозволів
# гаманця, тож його треба попросити явно; невідома назва — відмова, не підміна.
VITE_DATA_SOURCE=api
VITE_VAPID_PUBLIC_KEY=REPLACE_ME
